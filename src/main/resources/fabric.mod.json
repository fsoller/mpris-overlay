{
	"schemaVersion": 1,
	"id": "mprisdisplay",
	"version": "${version}",
	"name": "MPRIS Display",
	"description": "Shows the track playing in any MPRIS media player (via playerctl) as a small HUD in the game.",
	"authors": [
		"soller"
	],
	"contact": {
		"sources": "https://github.com/honsoller/mpris-overlay",
		"issues": "https://github.com/honsoller/mpris-overlay/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/mprisdisplay/textures/boymoder.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"me.soller.mprisdisplay.MPRISDisplay"
		],
		"client": [
			"me.soller.mprisdisplay.client.MPRISDisplayClient"
		],
		"modmenu": [
			"me.soller.mprisdisplay.client.MPRISDisplayModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
